{
  "name": "personel-directory",
  "version": "2.0.0",
  "private": true,
  "description": "Direktori dan dashboard analitik personel berbasis berkas Excel",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "photos:manifest": "node scripts/generate-photo-manifest.mjs",
    "photos:compress": "node scripts/compress-photos.mjs",
    "awards": "node scripts/awards-from-xlsx.mjs",
    "awards:manifest": "node scripts/generate-awards-manifest.mjs",
    "validate": "node scripts/validate-data.mjs data/data.xlsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "multer": "^2.3.0"
  }
}
